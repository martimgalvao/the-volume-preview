{
  "name": "the-volume-preview",
  "productName": "The Volume Preview",
  "version": "0.1.1",
  "description": "Desktop preview of The Volume: the 3D viewer with an NDI input for Resolume and other players",
  "author": {
    "name": "Martim S. Galv\u00e3o",
    "email": "martim@startmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sync-viewer": "cp \"${VOLUME_ROOT:-$HOME/the-volume}/viewer/the_volume_3d_no-treatment.html\" viewer.html",
    "deps": "npm install --force",
    "dist": "electron-builder --mac --win --linux",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "grandi": "^2.0.2",
    "@grandi/darwin-arm64": "2.0.2",
    "@grandi/darwin-x64": "2.0.2",
    "@grandi/linux-x64": "2.0.2",
    "@grandi/win32-x64": "2.0.2"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "edu.csusb.xreal.the-volume-preview",
    "productName": "The Volume Preview",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "sign.js"
    ],
    "extraResources": [
      {
        "from": "viewer.html",
        "to": "viewer.html"
      }
    ],
    "asarUnpack": [
      "node_modules/@grandi/**",
      "node_modules/grandi/**"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "files": [
        "!**/node_modules/@grandi/win32-*/**",
        "!**/node_modules/@grandi/linux-*/**"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!**/node_modules/@grandi/darwin-*/**",
        "!**/node_modules/@grandi/linux-*/**"
      ]
    },
    "afterPack": "sign.js",
    "linux": {
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!**/node_modules/@grandi/darwin-*/**",
        "!**/node_modules/@grandi/win32-*/**"
      ]
    }
  },
  "homepage": "https://github.com/martimgalvao/the-volume-preview",
  "repository": "github:martimgalvao/the-volume-preview"
}
